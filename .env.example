DATABASE_URL=postgres://user:password@localhost:5432/chill_express
APP_URL=http://localhost:3000
BETTER_AUTH_SECRET=generate-with-openssl-rand-hex-32
BETTER_AUTH_URL=http://localhost:3000
CRON_SECRET=generate-a-random-string
UPLOAD_DIR=./uploads
# "paystack" or "dev-sim" (dev-sim is refused when NODE_ENV=production)
PAYMENTS_DRIVER=paystack
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_PUBLIC_KEY=pk_test_xxx
# Required to use dev-sim with a production build (local CEO demo). NEVER set on the live server.
ALLOW_SIMULATED_PAYMENTS=false
DEV_SIM_SECRET=
